    "check:full": "bash scripts/check.sh --full",
    "assets": "node scripts/assets/pipeline.mjs",
    "assets:sample": "node scripts/assets/sample.mjs",
    "assets:test": "node scripts/assets/test.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
